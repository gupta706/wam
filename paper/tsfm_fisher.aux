\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Three foundation-model paradigms as \emph  {channels of one partially observed process} on a shared approximate-information-state (AIS) latent. A \textsc  {wam}\ predicts an environment's next \emph  {image} given the action taken; a \textsc  {tsfm}\ predicts a numerical series' next value with \emph  {no} action; a \textsc  {vla}\ predicts the next \emph  {action} from an image and a language instruction. They differ only in which modality they observe and in whether they emit or condition on actions---and hence in which block of the \emph  {one} Fisher information matrix governs their learning. Deleting the action channel collapses the joint FIM to the single system-identification block $\mathcal  {I}_{\theta \theta }$ shared by \textsc  {wam}\ and \textsc  {tsfm}\ (\cref  {eq:collapse}).}}{2}{table.1}\protected@file@percent }
\newlabel{tab:paradigms}{{1}{2}{Three foundation-model paradigms as \emph {channels of one partially observed process} on a shared approximate-information-state (AIS) latent. A \WAM \ predicts an environment's next \emph {image} given the action taken; a \TSFM \ predicts a numerical series' next value with \emph {no} action; a \VLA \^^Mpredicts the next \emph {action} from an image and a language instruction. They differ only in which modality they observe and in whether they emit or condition on actions---and hence in which block of the \emph {one} Fisher information matrix governs their learning. Deleting the action channel collapses the joint FIM to the single system-identification block $\Ith $ shared by \WAM \ and \TSFM \^^M(\cref {eq:collapse})}{table.1}{}}
\newlabel{tab:paradigms@cref}{{[table][1][]1}{[1][2][]2}{}{}{}}

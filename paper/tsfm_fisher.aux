\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The fusion \eqref  {eq:collapse}. A time-series foundation model is a world-action model with the action channel deleted: the policy block $\mathcal  {I}_{\phi \phi }$ and the cross block $\mathcal  {I}_{\theta \phi }$ vanish, and the joint Fisher information collapses to the single world (system-identification) block $\mathcal  {I}_{\theta \theta }$. The \textsc  {tsfm}\ is the single-block corner of the two-block theory of~\cite  {wamvla}.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:collapse}{{1}{3}{The fusion \eqref {eq:collapse}. A time-series foundation model is a world-action model with the action channel deleted: the policy block $\Iph $ and the cross block $\Itp $ vanish, and the joint Fisher information collapses to the single world (system-identification) block $\Ith $. The \TSFM \ is the single-block corner of the two-block theory of~\cite {wamvla}}{figure.1}{}}
